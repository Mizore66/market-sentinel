# Market Sentinel - Environment Variables
# Copy this file to ".env" and fill in your free Groq API key.
# Get one (free) at: https://console.groq.com/keys

# --- LLM provider (cheapest default: Groq free tier) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional: switch to OpenAI instead of Groq ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
